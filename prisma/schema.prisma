generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  ADMIN
  WORKER
}

// PENDING_VERIFICATION jest domyślnym stanem nowego klienta — dopiero ręczne
// przejście do STANDARD (przez OnboardingRequest albo bezpośrednią decyzję
// admina) odblokowuje standardową ścieżkę rezerwacji. Patrz ARCHITEKTURA.md
// sekcja 5 pkt 13.
enum ClientStatus {
  PENDING_VERIFICATION
  STANDARD
  TRUSTED_RECURRING
}

enum OnboardingRequestStatus {
  NEW
  MEETING_SCHEDULED
  VISITED
  APPROVED
  REJECTED
}

enum AvailabilityExceptionType {
  DAY_OFF
  CUSTOM_HOURS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  ISSUE
}

enum BookingSource {
  ONLINE_STANDARD
  RECURRING_GENERATED
  FROM_QUOTE
  ADMIN_MANUAL
}

enum CancelledBy {
  CLIENT
  ADMIN
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum RecurringCreatedBy {
  CLIENT
  ADMIN
}

enum QuoteRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CONVERTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum PaymentType {
  BOOKING_PAYMENT
  INVOICE
}

// Wynik reguły anulacji/zwrotu faktycznie zastosowany do danej płatności —
// patrz ARCHITEKTURA.md sekcja 5 pkt 4 (dwa niezależne progi: okno operacyjne
// i ustawowe prawo odstąpienia).
enum RefundType {
  FULL_SELF_SERVICE
  FULL_STATUTORY_RIGHT
  PARTIAL_POLICY
  MANUAL_ISSUE
}

// ---------------------------------------------------------------------------
// Konta i role
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  // Nullable: obsługuje konta założone ręcznie przez admina (zaproszenie
  // e-mailem), zanim klient sam ustawi hasło przez link.
  passwordHash String?
  role         Role
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Zaproszenie do ustawienia hasła (ścieżka: admin zakłada konto klienta).
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  invitedAt            DateTime?
  invitedById          String?
  invitedBy            User?     @relation("UserInvites", fields: [invitedById], references: [id])
  invitedUsers         User[]    @relation("UserInvites")

  clientProfile ClientProfile? @relation("ClientProfileOwner")
  employee      Employee?

  verifiedClientProfiles    ClientProfile[]     @relation("ClientProfileVerifier")
  conductedOnboardingVisits OnboardingRequest[] @relation("OnboardingConductor")
  approvedOnboardingReviews OnboardingRequest[] @relation("OnboardingApprover")
  notificationLogs          NotificationLog[]

  @@map("users")
}

model ClientProfile {
  id     String       @id @default(cuid())
  userId String       @unique
  user   User         @relation("ClientProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  // PENDING_VERIFICATION jest domyślne — patrz komentarz przy enumie
  // ClientStatus i ARCHITEKTURA.md sekcja 5 pkt 13.
  status ClientStatus @default(PENDING_VERIFICATION)

  // Kiedy i przez kogo klient przeszedł na STANDARD — niezależnie od tego,
  // czy stało się to przez zatwierdzenie OnboardingRequest, czy ręczną
  // decyzję admina bez formalnego zgłoszenia.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("ClientProfileVerifier", fields: [verifiedById], references: [id])

  // Zgoda marketingowa RODO na SMS-y — niezależna od transakcyjnych
  // przypomnień/potwierdzeń, które jej nie wymagają.
  marketingSmsConsent   Boolean   @default(false)
  marketingSmsConsentAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  addresses          PropertyAddress[]
  bookings           Booking[]
  recurringSeries    RecurringSeries[]
  quoteRequests      QuoteRequest[]
  onboardingRequests OnboardingRequest[]
  payments           Payment[]
  reviews            Review[]

  @@map("client_profiles")
}

// Klient może zapisać wiele adresów. Dzielnica jest atrybutem adresu
// (adres fizycznie leży w konkretnej dzielnicy) — przy wyborze zapisanego
// adresu districtId w rezerwacji ustawia się automatycznie z adresu.
model PropertyAddress {
  id            String        @id @default(cuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label         String
  districtId    String
  district      District      @relation(fields: [districtId], references: [id])
  street        String
  buildingNo    String
  apartmentNo   String?
  postalCode    String
  city          String
  defaultSizeM2 Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookings           Booking[]
  recurringSeries    RecurringSeries[]
  onboardingRequests OnboardingRequest[]
  checklistItems     PropertyChecklistItem[]

  @@index([clientId])
  @@index([districtId])
  @@map("property_addresses")
}

model Employee {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability           EmployeeAvailability[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]
  preferredForSeries     RecurringSeries[]

  @@map("employees")
}

// ---------------------------------------------------------------------------
// Dzielnice, dostępność, cennik
// ---------------------------------------------------------------------------

model District {
  id        String   @id @default(cuid())
  name      String
  city      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses       PropertyAddress[]
  availability    EmployeeAvailability[]
  pricingRules    PricingRule[]
  bookings        Booking[]
  recurringSeries RecurringSeries[]
  quoteRequests   QuoteRequest[]

  @@unique([name, city])
  @@map("districts")
}

// Cykliczny harmonogram tygodniowy. Jeden pracownik w danym terminie
// pracuje w JEDNEJ dzielnicy — model celowo nie zakłada przemieszczania się
// między dzielnicami w ciągu dnia.
model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  dayOfWeek  Int // 0 = niedziela ... 6 = sobota
  startTime  DateTime @db.Time
  endTime    DateTime @db.Time
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([districtId, dayOfWeek])
  @@map("employee_availability")
}

// Nadpisuje harmonogram tygodniowy dla konkretnej daty (urlop, L4, skrócony
// dzień pracy) — niezależnie od EmployeeAvailability.
model AvailabilityException {
  id         String                    @id @default(cuid())
  employeeId String
  employee   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime                  @db.Date
  type       AvailabilityExceptionType
  startTime  DateTime?                 @db.Time
  endTime    DateTime?                 @db.Time
  note       String?
  createdAt  DateTime                  @default(now())

  @@unique([employeeId, date])
  @@map("availability_exceptions")
}

// Osobna tabela edytowalna przez admina (np. "standardowe", "generalne/po
// remoncie") — nie sztywny enum, spójnie z resztą cennika konfigurowalnego
// z panelu bez wdrożenia nowej wersji kodu.
model ServiceType {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules    PricingRule[]
  bookings        Booking[]
  recurringSeries RecurringSeries[]

  @@map("service_types")
}

// Stawka i czas trwania wizyty zależne łącznie od dzielnicy, rodzaju usługi
// i przedziału m² — ta sama logika przedziałowa napędza jednocześnie cenę i
// długość okienka w kalendarzu pracownika.
model PricingRule {
  id              String      @id @default(cuid())
  districtId      String
  district        District    @relation(fields: [districtId], references: [id])
  serviceTypeId   String
  serviceType     ServiceType @relation(fields: [serviceTypeId], references: [id])
  sizeM2From      Int
  sizeM2To        Int
  price           Decimal     @db.Decimal(10, 2)
  durationMinutes Int
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([districtId, serviceTypeId])
  @@map("pricing_rules")
}

// Pojedynczy rekord konfiguracyjny (singleton, id zawsze = 1).
model Settings {
  id                         Int      @id @default(1)
  individualQuoteThresholdM2 Int      @default(50)
  // Próg operacyjny: do tylu godzin przed wizytą klient anuluje
  // samoobsługowo, zwrot 100% automatyczny. Po przekroczeniu — przycisk w
  // panelu klienta wyszarzony.
  operationalLockWindowHours Int      @default(24)
  // Procent zwrotu przy anulacji po zamknięciu okna operacyjnego, o ile
  // rezerwacja nie podlega już ustawowemu prawu odstąpienia (patrz
  // RefundType.FULL_STATUTORY_RIGHT).
  partialRefundPercentage    Int      @default(50)
  updatedAt                  DateTime @updatedAt

  // Uwaga: ustawowy termin odstąpienia konsumenta (14 dni, art. 27 ustawy o
  // prawach konsumenta) jest CELOWO nieobecny w tej tabeli — to stała
  // aplikacyjna (patrz packages/shared), nieedytowalna przez admina, żeby
  // wykluczyć przypadkowe złamanie prawa przy zmianie ustawień.

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Zlecenia
// ---------------------------------------------------------------------------

// Checklisty są własnością konkretnej nieruchomości, nie jednym globalnym
// szablonem (zmiana z 2026-09-15) — patrz ARCHITEKTURA.md sekcja 2.

enum ChecklistPackageType {
  STANDARD
  ADDITIONAL
}

// Globalna pula możliwych czynności — słownik, z którego admin wybiera przy
// konfigurowaniu checklisty konkretnej nieruchomości (bezpośrednio albo przez
// paczkę-skrót).
model ChecklistTaskCatalog {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packageItems ChecklistPackageItem[]

  @@map("checklist_task_catalog")
}

// Nazwany zestaw czynności z katalogu — WYŁĄCZNIE skrót przy konfigurowaniu
// checklisty nieruchomości (patrz PropertyChecklistItem). Nie ma trwałego
// związku "ta nieruchomość używa tej paczki" — dodanie paczki po prostu
// kopiuje jej czynności do płaskiej listy nieruchomości.
model ChecklistPackage {
  id        String               @id @default(cuid())
  name      String
  type      ChecklistPackageType
  // Dokładnie jedna paczka STANDARD powinna mieć isDefault=true — to ona
  // jest automatycznie kopiowana do nowej nieruchomości przy jej utworzeniu.
  isDefault Boolean              @default(false)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  items ChecklistPackageItem[]

  @@map("checklist_packages")
}

model ChecklistPackageItem {
  id        String               @id @default(cuid())
  packageId String
  package   ChecklistPackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  taskId    String
  task      ChecklistTaskCatalog @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sortOrder Int                  @default(0)

  @@unique([packageId, taskId])
  @@map("checklist_package_items")
}

// Faktyczna, płaska checklista danej nieruchomości. Niezależna od katalogu
// po dodaniu (brak FK z powrotem) — edycja/usunięcie czynności w katalogu
// nie zmienia już skonfigurowanych checklist nieruchomości.
model PropertyChecklistItem {
  id                String          @id @default(cuid())
  propertyAddressId String
  propertyAddress   PropertyAddress @relation(fields: [propertyAddressId], references: [id], onDelete: Cascade)
  label             String
  sortOrder         Int             @default(0)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())

  @@index([propertyAddressId])
  @@map("property_checklist_items")
}

model Booking {
  id                String           @id @default(cuid())
  clientId          String
  client            ClientProfile    @relation(fields: [clientId], references: [id])
  employeeId        String?
  employee          Employee?        @relation(fields: [employeeId], references: [id])
  districtId        String
  district          District         @relation(fields: [districtId], references: [id])
  propertyAddressId String
  propertyAddress   PropertyAddress  @relation(fields: [propertyAddressId], references: [id])
  serviceTypeId     String
  serviceType       ServiceType      @relation(fields: [serviceTypeId], references: [id])
  sizeM2            Int
  scheduledStart    DateTime
  scheduledEnd      DateTime
  // Snapshot ceny z PricingRule w momencie rezerwacji — późniejsza zmiana
  // cennika nie zmienia ceny już złożonych zleceń.
  price             Decimal          @db.Decimal(10, 2)
  status            BookingStatus    @default(PENDING)
  source            BookingSource
  recurringSeriesId String?
  recurringSeries   RecurringSeries? @relation(fields: [recurringSeriesId], references: [id])

  // Potwierdzenie realizacji przez pracownika
  completedAt        DateTime?
  completionNote     String?
  completionPhotoUrl String?

  // Anulacja — patrz ARCHITEKTURA.md sekcja 5 pkt 4 dla pełnej logiki
  cancelledAt                               DateTime?
  cancelledBy                               CancelledBy?
  // Snapshot wyniku reguły ustawowej w momencie zgłoszenia anulacji (nie
  // przeliczany retroaktywnie później, gdyby stała prawna się zmieniła).
  statutoryWithdrawalEligibleAtCancellation Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistItems   BookingChecklistItem[]
  review           Review?
  payments         Payment[]
  quoteRequest     QuoteRequest?
  notificationLogs NotificationLog[]

  @@index([clientId])
  @@index([employeeId])
  @@index([districtId])
  @@index([scheduledStart])
  @@map("bookings")
}

model BookingChecklistItem {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Skopiowane z PropertyChecklistItem danej nieruchomości w momencie
  // utworzenia Booking (snapshot).
  label       String
  sortOrder   Int
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@index([bookingId])
  @@map("booking_checklist_items")
}

// Seria/subskrypcja cykliczna, z której generowane są kolejne pojedyncze
// Booking (cron, z miesięcznym wyprzedzeniem względem bieżącej daty).
model RecurringSeries {
  id                  String             @id @default(cuid())
  clientId            String
  client              ClientProfile      @relation(fields: [clientId], references: [id])
  propertyAddressId   String
  propertyAddress     PropertyAddress    @relation(fields: [propertyAddressId], references: [id])
  districtId          String
  district            District           @relation(fields: [districtId], references: [id])
  serviceTypeId       String
  serviceType         ServiceType        @relation(fields: [serviceTypeId], references: [id])
  preferredEmployeeId String?
  preferredEmployee   Employee?          @relation(fields: [preferredEmployeeId], references: [id])
  frequency           RecurringFrequency
  preferredDayOfWeek  Int
  preferredStartTime  DateTime           @db.Time
  sizeM2              Int
  status              RecurringStatus    @default(ACTIVE)
  createdBy           RecurringCreatedBy
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  bookings Booking[]

  @@index([clientId])
  @@index([status])
  @@map("recurring_series")
}

// Zapytanie o indywidualną wycenę — NIE wymaga zalogowania (lekki formularz
// kontaktowy, niższy próg wejścia dla dużych nieruchomości), więc clientId
// jest nullable, a dane kontaktowe są zbierane wprost w formularzu.
model QuoteRequest {
  id                  String             @id @default(cuid())
  clientId            String?
  client              ClientProfile?     @relation(fields: [clientId], references: [id])
  contactName         String
  contactPhone        String
  contactEmail        String
  propertyDescription String
  sizeM2              Int
  districtId          String
  district            District           @relation(fields: [districtId], references: [id])
  status              QuoteRequestStatus @default(NEW)
  quotedPrice         Decimal?           @db.Decimal(10, 2)
  convertedBookingId  String?            @unique
  convertedBooking    Booking?           @relation(fields: [convertedBookingId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("quote_requests")
}

// Zapytanie o rozpoczęcie współpracy — osobny typ zgłoszenia od QuoteRequest
// (inny powód: weryfikacja nowego, nieznanego klienta przed dopuszczeniem go
// do standardowej ścieżki rezerwacji, nie wycena dużej nieruchomości).
// W przeciwieństwie do QuoteRequest WYMAGA konta — klient rejestruje się od
// razu, tylko w statusie ClientStatus.PENDING_VERIFICATION.
model OnboardingRequest {
  id                String                  @id @default(cuid())
  clientId          String
  client            ClientProfile           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyAddressId String
  propertyAddress   PropertyAddress         @relation(fields: [propertyAddressId], references: [id])
  clientMessage     String?
  status            OnboardingRequestStatus @default(NEW)

  // Spotkanie fizyczne pod adresem — widoczne w kalendarzu admina obok zleceń.
  meetingScheduledAt DateTime?
  conductedById      String?
  conductedBy        User?     @relation("OnboardingConductor", fields: [conductedById], references: [id])
  // Wyposażenie, stan zabrudzenia nieruchomości, szczególne uwarunkowania/
  // zmienne istotne przy przyszłych zleceniach.
  visitNotes         String?

  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?     @relation("OnboardingApprover", fields: [approvedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("onboarding_requests")
}

// ---------------------------------------------------------------------------
// Płatności i oceny
// ---------------------------------------------------------------------------

// bookingId jest nullable celowo: przyszły moduł faktur dla stałych klientów
// (płatność BLIK niepowiązana ze standardową rezerwacją online) nie będzie
// wymagał zmiany modelu.
model Payment {
  id                String        @id @default(cuid())
  bookingId         String?
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  clientId          String
  client            ClientProfile @relation(fields: [clientId], references: [id])
  provider          String
  providerPaymentId String
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  type              PaymentType   @default(BOOKING_PAYMENT)

  refundedAt       DateTime?
  refundPercentage Int?
  refundType       RefundType?
  refundReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([clientId])
  @@map("payments")
}

model Review {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Powiadomienia
// ---------------------------------------------------------------------------

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  ONBOARDING_APPROVED
  ONBOARDING_REJECTED
  QUOTE_READY
}

enum NotificationStatus {
  SENT
  FAILED
}

// Dziennik powiadomień e-mail. Świadomy stub (patrz ARCHITEKTURA.md sekcja
// 5 pkt 11/13 i packages/shared/notifications.ts) — dopóki nie wybrano
// dostawcy (np. Resend), "wysyłka" to zapis tego rekordu (zawsze
// status=SENT) + log na konsoli, żeby cała logika wyzwalania powiadomień
// była gotowa i przetestowana, zanim podłączymy prawdziwy provider. Służy
// też jako źródło idempotencji dla przypomnień przed wizytą (nie wysyłamy
// drugi raz przypomnienia dla tego samego Booking).
model NotificationLog {
  id             String             @id @default(cuid())
  type           NotificationType
  recipientEmail String
  userId         String?
  user           User?              @relation(fields: [userId], references: [id])
  subject        String
  body           String
  bookingId      String?
  booking        Booking?           @relation(fields: [bookingId], references: [id])
  status         NotificationStatus @default(SENT)
  createdAt      DateTime           @default(now())

  @@index([bookingId, type])
  @@index([userId])
  @@map("notification_logs")
}
